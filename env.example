# ===== Django Core =====
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Database =====
DB_NAME=cnpm_db
DB_USER=calendar
DB_PASSWORD=123
DB_HOST=127.0.0.1
DB_PORT=3306

# ===== Frontend =====
# URL trỏ tới Next.js frontend (dùng trong email xác thực / khôi phục mật khẩu)
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ===== CORS =====
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Bật = 'true' chỉ khi cần cho phép mọi origin (không khuyến khích khi deploy)
CORS_ALLOW_ALL=false

# ===== Email (SMTP) =====
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-here
