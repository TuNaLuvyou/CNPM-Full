# ===== Django Core =====
SECRET_KEY=your-django-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# ===== Database (PostgreSQL) =====
# --- Option 1: Local Docker (chạy docker-compose up -d db) ---
DB_NAME=cnpm_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Option 2: Supabase Cloud ---
# DB_NAME=postgres
# DB_USER=postgres.[project-ref]
# DB_PASSWORD=your-supabase-db-password
# DB_HOST=aws-1-ap-northeast-2.pooler.supabase.com
# DB_PORT=5432

# ===== Frontend =====
# URL trỏ tới Next.js frontend (dùng trong email xác thực / khôi phục mật khẩu)
FRONTEND_URL=http://localhost:3000

# ===== CORS =====
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Bật = 'true' chỉ khi cần cho phép mọi origin (không khuyến khích khi deploy)
CORS_ALLOW_ALL=false

# ===== Email (SMTP) =====
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password-here
